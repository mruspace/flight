#!/bin/sh
# run: entry point for the Mru Flight experiment on OPS-SAT PRETTY [exp4051],
# run 4: a device that stops answering, and automatic resets. The F´
# deployment of run 3, version 2, with each replica in a process of its own,
# spread over the processor's two cores.
#
# The OPS-SAT runner executes ./run as user exp in $HOME, which holds the
# files of this package, and collects everything written under $HOME when the
# run ends. This script runs in the foreground, three segments one after the
# other, writes all output to toGround/, and exits. It stops by itself inside
# the five-minute window: the caps below add up to 120 seconds.
#
# MruQuorum is the manager process: Mru's RedundancyManager, HealthRegistry
# and FaultInjector with F´'s command dispatcher, event manager, telemetry
# database, health pings and command sequencer, driven by a Linux timer every
# CYCLE_MS. It starts three MruReplica processes, one ReplicaHost each,
# linked through F´'s GenericHub over Unix socket pairs (no network), pinned
# to the cores in CORES. The hangs are commanded by F´ command sequences
# (reset.bin, shrink.bin, tmr.bin) and applied by FaultInjector; a reset
# from the manager ends a hang in FaultInjector, as a platform reset would
# end it in a device. The dead unit is real: the manager sends SIGKILL to
# replica 2's process at the start of cycle KILL_CYCLE, and no reset brings
# a killed process back.
#
#   1  reset    the shrinking quorum with automatic resets (ResetLimit 3),
#               cap RESET_SECONDS
#   2  shrink   the same faults, resets off, cap SHRINK_SECONDS
#   3  tmr      the same faults under fixed TMR, no resets, cap TMR_SECONDS
#
# Settings (environment variables, defaults in brackets):
#   SEGMENTS          segments to run, in order      [reset shrink tmr]
#   RESET_SECONDS     cap of segment 1               [40]
#   SHRINK_SECONDS    cap of segment 2               [40]
#   TMR_SECONDS       cap of segment 3               [40]
#   CYCLE_MS          cycle period in milliseconds   [100]
#   MEMORY_MB         address-space limit, each      [128]
#   CORES             replicas' cores                [0,1,1]
#   KILL_CYCLE        cycle of the real kill         [150]
#   DEPLOYMENT        the manager binary             [./MruQuorum]
#   REPLICA           the replica binary             [./MruReplica]
#   OUT_DIR           output folder                  [./toGround]
set -u

here=$(cd "$(dirname "$0")" && pwd)
cd "$here" || exit 2
SEGMENTS=${SEGMENTS:-"reset shrink tmr"}
RESET_SECONDS=${RESET_SECONDS:-40}
SHRINK_SECONDS=${SHRINK_SECONDS:-40}
TMR_SECONDS=${TMR_SECONDS:-40}
CYCLE_MS=${CYCLE_MS:-100}
MEMORY_MB=${MEMORY_MB:-128}
CORES=${CORES:-0,1,1}
KILL_CYCLE=${KILL_CYCLE:-150}
DEPLOYMENT=${DEPLOYMENT:-$here/MruQuorum}
REPLICA=${REPLICA:-$here/MruReplica}
OUT_DIR=${OUT_DIR:-$here/toGround}

mkdir -p "$OUT_DIR" || exit 2
info=$OUT_DIR/run-info.txt
now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
{
    echo "experiment=exp4051 package=mru-flight-fprime-resets run=4"
    echo "start_utc=$(now)"
    echo "uname=$(uname -a 2>/dev/null)"
    echo "user=$(id 2>/dev/null)"
    echo "nproc=$(nproc 2>/dev/null) loadavg=$(cat /proc/loadavg 2>/dev/null)"
    echo "--- /proc/cpuinfo ---"; cat /proc/cpuinfo 2>/dev/null
    echo "--- /proc/meminfo (head) ---"; head -5 /proc/meminfo 2>/dev/null
    echo "---"
    echo "deployment_sha256=$(sha256sum "$DEPLOYMENT" 2>/dev/null | cut -d' ' -f1)"
    echo "replica_sha256=$(sha256sum "$REPLICA" 2>/dev/null | cut -d' ' -f1)"
    for s in reset shrink tmr; do
        echo "sequence_${s}_sha256=$(sha256sum "$here/$s.bin" 2>/dev/null | cut -d' ' -f1)"
    done
    echo "settings: segments=$SEGMENTS reset_seconds=$RESET_SECONDS shrink_seconds=$SHRINK_SECONDS tmr_seconds=$TMR_SECONDS cycle_ms=$CYCLE_MS memory_mb=$MEMORY_MB cores=$CORES kill_cycle=$KILL_CYCLE"
} >"$info"

child=
stop() {
    # Forward a stop request to the running deployment; it stops its timer,
    # writes its summary and exits.
    if [ -n "$child" ]; then
        kill -TERM "$child" 2>/dev/null
        wait "$child"
    fi
    echo "stopped_by_signal_utc=$(now)" >>"$info"
    exit 0
}
trap stop TERM INT HUP

status=0
for segment in $SEGMENTS; do
    case $segment in
    reset) secs=$RESET_SECONDS ;;
    shrink) secs=$SHRINK_SECONDS ;;
    tmr) secs=$TMR_SECONDS ;;
    *)
        echo "unknown segment $segment" >>"$info"
        status=1
        continue
        ;;
    esac
    echo "$segment: start_utc=$(now) max_seconds=$secs" >>"$info"
    "$DEPLOYMENT" -t "$secs" -p "$CYCLE_MS" -m "$MEMORY_MB" -R "$REPLICA" -C "$CORES" \
        -o "$OUT_DIR/summary-$segment.txt" -s "$here/$segment.bin" -k "kill:2@$KILL_CYCLE" \
        >"$OUT_DIR/events-$segment.txt" 2>&1 &
    child=$!
    wait "$child"
    rc=$?
    child=
    echo "$segment: exit=$rc end_utc=$(now)" >>"$info"
    [ "$rc" -eq 0 ] || status=1
done
echo "end_utc=$(now) status=$status" >>"$info"
exit "$status"
